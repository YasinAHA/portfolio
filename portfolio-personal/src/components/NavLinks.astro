---
const isMobile = Astro.props.isMobile ?? false;
const itemClass = isMobile
    ? "block text-neutral-900 dark:text-white hover:text-primary transition"
    : "text-neutral-900 dark:text-white hover:text-primary transition";
const wrapperClass = isMobile
    ? "flex flex-col gap-2 px-6 py-4 text-lg font-medium"
    : "hidden md:flex gap-6 text-lg font-medium";
---

<ul class={wrapperClass}>
    <li><a href="/" class={itemClass}>Inicio</a></li>
    <li><a href="/about" class={itemClass}>Sobre mí</a></li>
    <li><a href="/projects" class={itemClass}>Proyectos</a></li>
    <li><a href="/contact" class={itemClass}>Contacto</a></li>
</ul>
