---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer
    class="mt-12 px-6 pt-10 pb-6 text-center text-sm text-neutral-700 dark:text-neutral-300 backdrop-blur-md bg-white/60 dark:bg-neutral-900/60 border-t border-neutral-200 dark:border-neutral-700 shadow-inner rounded-t-2xl max-w-4xl mx-auto"
>
    <p class="mb-2">
        Desarrollado por
        <strong class="font-semibold text-neutral-900 dark:text-white">
            Yassine Ait El Hadj Ahajtan
        </strong>
    </p>

    <div class="flex justify-center gap-6 mt-4">
        <!-- GitHub -->
        <a
            href="https://github.com/YasinAHA"
            class="transition-all duration-300 hover:scale-110 hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-full"
            aria-label="GitHub de Yassine"
            target="_blank"
            rel="noopener noreferrer"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 fill-current"
                viewBox="0 0 24 24"
            >
                <path
                    d="M12 0a12 12 0 00-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.4.7-4.1-1.6-4.1-1.6a3.2 3.2 0 00-1.3-1.7c-1.1-.8.1-.8.1-.8a2.5 2.5 0 011.8 1.2 2.6 2.6 0 003.5 1 2.6 2.6 0 01.8-1.6c-2.7-.3-5.4-1.3-5.4-5.8a4.6 4.6 0 011.2-3.2 4.3 4.3 0 01.1-3.2s1-.3 3.3 1.2a11.4 11.4 0 016 0c2.2-1.5 3.3-1.2 3.3-1.2a4.3 4.3 0 01.1 3.2 4.6 4.6 0 011.2 3.2c0 4.5-2.8 5.5-5.4 5.8a2.8 2.8 0 01.8 2.2v3.2c0 .3.2.7.8.6A12 12 0 0012 0z"
                ></path>
            </svg>
        </a>

        <!-- LinkedIn -->
        <a
            href="https://www.linkedin.com/in/yassine-ait-el-hadj-ahajtan-574941264"
            class="transition-all duration-300 hover:scale-110 hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-full"
            aria-label="LinkedIn de Yassine"
            target="_blank"
            rel="noopener noreferrer"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 fill-current"
                viewBox="0 0 24 24"
            >
                <path
                    d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM0 8.999h5V24H0zM7.5 9h4.7v2.03h.07c.65-1.23 2.24-2.53 4.62-2.53 4.94 0 5.85 3.25 5.85 7.47V24h-5v-6.62c0-1.58-.03-3.6-2.2-3.6-2.2 0-2.54 1.72-2.54 3.49V24h-5z"
                ></path>
            </svg>
        </a>
    </div>

    <p class="text-xs mt-4">© {year} – Todos los derechos reservados</p>
</footer>
