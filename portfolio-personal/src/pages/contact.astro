---
// src/pages/contact.astro
import DefaultLayout from "../layouts/DefaultLayout.astro";
const formspreeEndpoint = "https://formspree.io/f/meokoajz";
---

<DefaultLayout>
    <section class="space-y-8 max-w-lg mx-auto">
        <h1
            data-motion="fade-down"
            data-delay="0.1"
            class="text-3xl font-bold text-center"
        >
            Contacto
        </h1>

        <form
            action={formspreeEndpoint}
            method="POST"
            class="space-y-4"
            data-motion="fade-up"
            data-delay="0.2"
        >
            <!-- Nombre -->
            <div class="flex flex-col">
                <label for="name" class="mb-1 font-medium">Nombre</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="px-4 py-2 border border-neutral-300 rounded focus:outline-none focus:ring-2 focus:ring-primary"
                />
            </div>

            <!-- Email -->
            <div class="flex flex-col">
                <label for="email" class="mb-1 font-medium">Email</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="px-4 py-2 border border-neutral-300 rounded focus:outline-none focus:ring-2 focus:ring-primary"
                />
            </div>

            <!-- Mensaje -->
            <div class="flex flex-col">
                <label for="message" class="mb-1 font-medium">Mensaje</label>
                <textarea
                    id="message"
                    name="message"
                    rows="5"
                    required
                    class="px-4 py-2 border border-neutral-300 rounded focus:outline-none focus:ring-2 focus:ring-primary"
                ></textarea>
            </div>

            <!-- Botón Enviar -->
            <button
                type="submit"
                class="w-full py-2 bg-primary text-white font-medium rounded hover:opacity-90 transition"
                data-motion="zoom-in"
                data-delay="0.3"
            >
                Enviar
            </button>

            <!-- Nota de éxito (usando el redirect de Formspree) -->
            <input type="hidden" name="_redirect" value="/thank-you" />
        </form>
    </section>
</DefaultLayout>
