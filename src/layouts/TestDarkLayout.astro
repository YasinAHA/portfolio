---
/*
  Layout de prueba para aislar el tema oscuro.
  NO importa nada de animaciones ni ClientRouter, solo CSS y el script de darkMode.

  Asegúrate de que tailwind.config.mjs está en darkMode: 'class'
  y de tener instalado Tailwind v4+.
*/
import "@styles/global.css";
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- EXECUTAMOS este script ANTES de que Tailwind meta cualquier <style> -->
        <script>
            (function () {
                const root = document.documentElement;
                const saved = localStorage.getItem("theme");
                if (
                    saved === "dark" ||
                    (!saved &&
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches)
                ) {
                    root.classList.add("dark");
                } else {
                    root.classList.remove("dark");
                }
            })();
        </script>
    </head>

    <body
        class="bg-white text-black dark:bg-black dark:text-white transition-colors"
    >
        <slot />
    </body>
</html>
