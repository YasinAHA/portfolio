---
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import "@styles/global.css";
import { ClientRouter } from "astro:transitions";
import initMotionURL from "@scripts/init-motion.js?url";

const siteTitle = "Yassine | Portfolio";
const siteDescription =
    "Portfolio de Yassine Ait El Hadj — Full-stack (React, Node.js, MongoDB, PHP, Java)";
const siteUrl = "https://tudominio.com";
const siteImage = "https://tudominio.com/og-image.png";

const pageTitle = Astro.props.title ?? siteTitle;
const pageDescription = Astro.props.description ?? siteDescription;
const pageImage = Astro.props.image ?? siteImage;
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />

        <!-- Previene parpadeo de tema -->
        <script>
            const theme = localStorage.theme;
            const prefersDark = matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches;
            if (theme === "dark" || (!theme && prefersDark)) {
                document.documentElement.classList.add("dark");
            }
        </script>
    </head>

    <astro:head>
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />

        <!-- OG / Twitter -->
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={pageImage} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={pageImage} />

        <link rel="icon" href="/favicon.ico" />
        <link rel="manifest" href="/manifest.json" />
        <meta name="theme-color" content="#4f46e5" />
    </astro:head>

    <!-- SPA-like navigation -->
    <ClientRouter />

    <body>
        <Navbar />

        <main class="min-h-[calc(100dvh-275px)] px-6 py-10 max-w-4xl mx-auto">
            <slot />
        </main>

        <Footer />

        <script type="module" src={initMotionURL}></script>

        <!-- Sincroniza iconos al cambiar de ruta -->
        <script is:inline>
            document.addEventListener("astro:after-swap", () => {
                const theme = localStorage.theme;
                const prefersDark = matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                const isDark = theme === "dark" || (!theme && prefersDark);
                document.documentElement.classList.toggle("dark", isDark);

                const sun = document.getElementById("icon-sun");
                const moon = document.getElementById("icon-moon");
                if (sun && moon) {
                    sun.classList.toggle("hidden", isDark);
                    moon.classList.toggle("hidden", !isDark);
                }
            });
        </script>
    </body>


</html>
